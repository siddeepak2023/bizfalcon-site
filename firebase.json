{
  "hosting": {
    "site": "bizfalcon-site",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "*.md",
      ".gitignore",
      ".git",
      "CNAME",
      "_*.html",
      "test-*.html",
      "_headmesh.js",
      "tools",
      "media",
      "shots",
      "head*.png",
      "falcon-lines-dark.png",
      "icon-192.png",
      "_render-head.html"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|woff2|png|jpg|webp|svg|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=2592000,immutable"
          }
        ]
      },
      {
        "source": "index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  }
}
